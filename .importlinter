; Contracts that keep the design's guarantees from decaying into intentions.
; Run with: uv run lint-imports
[importlinter]
root_packages =
    app
include_external_packages = True

[importlinter:contract:layers]
name = Layers: adapters -> graph -> evidence -> domain
type = layers
layers =
    app.slack | app.api | app.cli
    app.graph
    app.evidence
    app.domain
ignore_imports =
    app.graph.state -> app.evidence.envelope

[importlinter:contract:no-sync-io-in-graph]
; The domain layer this repo ported is synchronous; on the Socket Mode event loop a
; blocking client stalls the WebSocket and Slack throttles the app off new events.
; Sync I/O belongs in an MCP server process (spec 2.1).
name = No synchronous I/O clients inside graph or evidence
type = forbidden
; Direct imports only: app.tools owns the subprocess calls and wraps them in
; asyncio.to_thread, which is the approved hand-off. Catching that transitively would
; forbid the very layer built to contain it.
allow_indirect_imports = True
source_modules =
    app.graph
    app.evidence
forbidden_modules =
    psycopg
    subprocess

[importlinter:contract:domain-is-facts]
name = Domain is facts, not behaviour
type = forbidden
allow_indirect_imports = True
source_modules =
    app.domain
forbidden_modules =
    app.graph
    app.tools
    app.slack
    app.api
    langchain
    langgraph

[importlinter:contract:one-renderer]
; Every disclosure banner is computed in app.render.answer. Two renderers drift, and the
; one that drifts is the one that silently stops disclosing (spec 9, item 19).
name = Adapters do not reach into graph internals
type = forbidden
; Adapters call build_graph/run_turn; reaching past them into a node is what this forbids.
allow_indirect_imports = True
source_modules =
    app.slack
    app.api
forbidden_modules =
    app.graph.nodes

[importlinter:contract:records-are-not-retrieved]
; Runs are recorded and never retrieved during triage: burying the one useful entry under
; every attempt to find it is how a knowledge base degrades.
name = The graph never reads the ops record store
type = forbidden
allow_indirect_imports = True
source_modules =
    app.graph
    app.evidence
forbidden_modules =
    app.storage
